process {
    executor = 'local'

    withLabel: small {
        cpus = 2
        memory = 4.GB
        time = '2h'
    }

    withLabel: medium {
        cpus = 6
        memory = 32.GB
        time = '8h'
    }

    withLabel: large {
        cpus = 6
        memory = 64.GB
        time = '24h'
    }
}

trace {
    enabled = true
    file = 'reports/trace.txt'
    overwrite = true
}

report {
    enabled = true
    file = 'reports/report.html'
}

timeline {
    enabled = true
    file = 'reports/timeline.html'
}